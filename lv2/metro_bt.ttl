@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix atom: <http://lv2plug.in/ns/ext/atom#> .
@prefix midi: <http://lv2plug.in/ns/ext/midi#> .
@prefix time: <http://lv2plug.in/ns/ext/time#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<urn:metrobt:metro>
    a lv2:Plugin , lv2:UtilityPlugin ;
    doap:name "Metro BT" ;
    doap:license <https://www.gnu.org/licenses/agpl-3.0> ;
    lv2:minorVersion 1 ;
    lv2:microVersion 0 ;
    lv2:requiredFeature urid:map ;
    # Контроллеры строго с индексами 0..N-1, до atom-портов (так Zynthian нумерует параметры).
    lv2:port
    [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 0 ; lv2:symbol "on" ; lv2:name "On" ;
        lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 40 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 1 ; lv2:symbol "accent" ; lv2:name "Accent" ;
        lv2:default 1 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ;
        lv2:displayPriority 30 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 2 ; lv2:symbol "pulse" ; lv2:name "Pulse ms" ;
        lv2:default 60 ; lv2:minimum 20 ; lv2:maximum 300 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 20 ;
    ] , [
        a lv2:InputPort , lv2:ControlPort ;
        lv2:index 3 ; lv2:symbol "advance" ; lv2:name "Advance ms" ;
        lv2:default 50 ; lv2:minimum 0 ; lv2:maximum 300 ; lv2:portProperty lv2:integer ;
        lv2:displayPriority 10 ;
    ] , [
        a lv2:InputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent , time:Position ;
        lv2:designation lv2:control ;
        lv2:index 4 ; lv2:symbol "midi_in" ; lv2:name "MIDI In" ;
    ] , [
        a lv2:OutputPort , atom:AtomPort ;
        atom:bufferType atom:Sequence ;
        atom:supports midi:MidiEvent ;
        lv2:index 5 ; lv2:symbol "midi_out" ; lv2:name "MIDI Out" ;
    ] .
